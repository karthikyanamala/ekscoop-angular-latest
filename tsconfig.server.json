{
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "module": "es2022",                    // ✅ enables import.meta
    "target": "es2022",
    "moduleResolution": "node",
    "types": ["node"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "files": ["src/main.server.ts", "src/server.ts"]
}
